@model List<ProductsMvcClient.Models.Products>

@{
    ViewData["Title"] = "Lista de Productos";
}

<div class="container mt-4">
    <h2>Lista de Productos</h2>

    <div class="mb-3">
        <a href="@Url.Action("Create")" class="btn btn-primary">Nuevo Producto</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Categoría</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Nombre</td>
                        <td>@product.Descripcion</td>
                        <td>@product.Precio.ToString("C")</td>
                        <td>@(product.Categoria?.Name ?? "N/A")</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = product.Id })"
                               class="btn btn-warning btn-sm">Editar</a>
                            <button class="btn btn-danger btn-sm"
                                    onclick="confirmDelete(@product.Id, '@product.Nombre')">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de Confirmación -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de que desea eliminar el producto: <strong id="productName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productIdToDelete = null;

        function confirmDelete(id, name) {
            productIdToDelete = id;
            document.getElementById('productName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        document.getElementById('confirmDelete').addEventListener('click', function () {
            if (productIdToDelete) {
                fetch('@Url.Action("Delete", "Products")/' + productIdToDelete, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.getElementsByName('__RequestVerificationToken')[0].value
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Error al eliminar el producto');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al eliminar el producto');
                });

                bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            }
        });
    </script>
}